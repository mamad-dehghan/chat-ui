{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    "composite": true,
    "skipLibCheck": true,

    "types": ["bun"]
  },
  "include": ["vite.config.ts"]
}
